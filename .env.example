# Sansa's Kitchen — Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel: set these in Dashboard → Settings → Environment Variables
# For Netlify: set these in Site Settings → Build & Deploy → Environment
# For Cloudflare Pages: set these in Settings → Environment Variables

# ─── App ────────────────────────────────────────────────────────

# App name (displayed in browser title & OG tags)
VITE_APP_NAME=Sansa's Kitchen

# App tagline
VITE_APP_TAGLINE=Cook with Love, Create with Magic.

# Deployment base path (default: /)
VITE_BASE=/

# Environment: development | staging | production
VITE_ENV=development

# ─── URLs ───────────────────────────────────────────────────────

# Public-facing app URL (no trailing slash).
# Used for: canonical, OG tags, Twitter cards, sitemap, share links, auth redirects.
# Local development:
VITE_APP_URL=http://localhost:5173
# Production (Vercel):
# VITE_APP_URL=https://sansas-kitchen-kohl.vercel.app

# ─── Supabase ───────────────────────────────────────────────────

# Supabase project URL (Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── API ────────────────────────────────────────────────────────

# API base URL (uncomment if using a backend API)
# VITE_API_URL=https://api.example.com

# ─── Analytics ──────────────────────────────────────────────────

# Google Analytics Measurement ID (optional)
# VITE_GA_ID=G-XXXXXXXXXX
