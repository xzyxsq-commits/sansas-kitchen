# Sansa's Kitchen — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Vercel: set these in Dashboard → Settings → Environment Variables
# For Netlify: set these in Site Settings → Build & Deploy → Environment
# For Cloudflare Pages: set these in Settings → Environment Variables

# App name (displayed in browser title)
VITE_APP_NAME=Sansa's Kitchen

# App tagline
VITE_APP_TAGLINE=Cook with Love, Create with Magic.

# Deployment base path (default: /)
# Set to /subpath/ if deploying to a subdirectory
VITE_BASE=/

# Environment: development | staging | production
VITE_ENV=production

# API base URL (uncomment and set if using a backend API)
# VITE_API_URL=https://api.example.com

# Google Analytics Measurement ID (optional)
# VITE_GA_ID=G-XXXXXXXXXX
